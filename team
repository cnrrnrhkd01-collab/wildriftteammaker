<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>와일드리프트 내전 팀 메이커</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700;900&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Noto Sans KR"', 'sans-serif'],
                    },
                    colors: {
                        wr: {
                            dark: '#0a0a0c',
                            panel: '#1e2328',
                            gold: '#c89b3c',
                            goldHover: '#f0e6d2',
                            blue: '#005a82',
                            blueLight: '#0ac8b9',
                            red: '#c83c3c',
                        }
                    },
                    animation: {
                        'fade-in': 'fadeIn 0.5s ease-out forwards',
                        'slide-up': 'slideUp 0.5s ease-out forwards',
                    },
                    keyframes: {
                        fadeIn: {
                            '0%': { opacity: '0' },
                            '100%': { opacity: '1' },
                        },
                        slideUp: {
                            '0%': { opacity: '0', transform: 'translateY(20px)' },
                            '100%': { opacity: '1', transform: 'translateY(0)' },
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #0a0a0c;
            background-image: radial-gradient(circle at 50% 0%, #1a1c23 0%, #0a0a0c 70%);
            color: #f0e6d2;
            min-height: 100vh;
        }
        
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #0a0a0c; }
        ::-webkit-scrollbar-thumb { background: #c89b3c; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #f0e6d2; }

        .hex-border {
            clip-path: polygon(10% 0, 100% 0, 100% 90%, 90% 100%, 0 100%, 0 10%);
        }
    </style>
</head>
<body class="p-4 md:p-8">

    <div class="max-w-4xl mx-auto">
        <!-- Header -->
        <header class="text-center mb-10 animate-fade-in">
            <h1 class="text-4xl md:text-5xl font-black mb-2 text-transparent bg-clip-text bg-gradient-to-r from-wr-gold to-yellow-200 uppercase tracking-wider">
                Wild Rift <br/> Custom Game Balancer
            </h1>
            <p class="text-gray-400 text-lg">와일드리프트 내전 팀 메이커</p>
        </header>

        <!-- Input Section -->
        <main class="bg-wr-panel border border-wr-gold/30 rounded-xl p-6 shadow-2xl mb-8 animate-slide-up">
            <div id="roles-container" class="space-y-6">
                <!-- Javascript will populate this -->
            </div>

            <div class="mt-10 text-center">
                <button id="generate-btn" class="relative group bg-gradient-to-r from-wr-gold to-yellow-600 text-wr-dark font-bold text-xl px-12 py-4 rounded-sm transition-all hover:scale-105 shadow-[0_0_15px_rgba(200,155,60,0.4)] hover:shadow-[0_0_25px_rgba(200,155,60,0.8)]">
                    <span class="relative z-10">팀 짜기 (Generate Teams)</span>
                    <div class="absolute inset-0 border-2 border-white/20 scale-105 opacity-0 group-hover:opacity-100 transition-all rounded-sm"></div>
                </button>
                <div id="error-message" class="text-wr-red mt-4 font-bold hidden">모든 플레이어의 이름과 티어를 확인해주세요.</div>
            </div>
        </main>

        <!-- Results Section -->
        <section id="results-section" class="hidden">
            <div class="text-center mb-6 animate-fade-in">
                <h2 class="text-3xl font-bold text-wr-goldHover">매칭 결과</h2>
                <p id="score-difference" class="text-xl text-gray-300 mt-2 font-medium"></p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- Team A (Blue) -->
                <div id="team-a-card" class="bg-gradient-to-b from-blue-900/40 to-wr-panel border border-blue-500/50 rounded-lg p-6 shadow-[0_0_20px_rgba(0,90,130,0.3)] opacity-0 transform translate-y-4 transition-all duration-700">
                    <div class="border-b border-blue-500/30 pb-4 mb-4 flex justify-between items-end">
                        <h3 class="text-2xl font-black text-blue-400">TEAM A <span class="text-sm font-normal text-gray-400 ml-2">블루 진영</span></h3>
                        <div class="text-right">
                            <span class="text-sm text-gray-400 block">총점</span>
                            <span id="team-a-score" class="text-3xl font-bold text-white">0</span>
                        </div>
                    </div>
                    <ul id="team-a-list" class="space-y-3"></ul>
                </div>

                <!-- Team B (Red) -->
                <div id="team-b-card" class="bg-gradient-to-b from-red-900/40 to-wr-panel border border-red-500/50 rounded-lg p-6 shadow-[0_0_20px_rgba(200,60,60,0.3)] opacity-0 transform translate-y-4 transition-all duration-700 delay-100">
                    <div class="border-b border-red-500/30 pb-4 mb-4 flex justify-between items-end">
                        <h3 class="text-2xl font-black text-red-400">TEAM B <span class="text-sm font-normal text-gray-400 ml-2">레드 진영</span></h3>
                        <div class="text-right">
                            <span class="text-sm text-gray-400 block">총점</span>
                            <span id="team-b-score" class="text-3xl font-bold text-white">0</span>
                        </div>
                    </div>
                    <ul id="team-b-list" class="space-y-3"></ul>
                </div>
            </div>
        </section>
    </div>

    <script>
        const tiers = [
            { name: '브론즈 (Bronze)', value: 1, color: 'text-orange-400' },
            { name: '실버 (Silver)', value: 2, color: 'text-gray-400' },
            { name: '골드 (Gold)', value: 3, color: 'text-yellow-400' },
            { name: '플레티넘 (Platinum)', value: 4, color: 'text-emerald-200' },
            { name: '에메랄드 (Emerald)', value: 5, color: 'text-emerald-500' },
            { name: '다이아 (Diamond)', value: 6, color: 'text-purple-400' },
            { name: '마스터 (Master)', value: 7, color: 'text-fuchsia-400' },
            { name: '그랜드마스터 (Grandmaster)', value: 8, color: 'text-red-400' },
            { name: '챌린저 (Challenger)', value: 9, color: 'text-blue-300' },
            { name: '소버린 (Sovereign)', value: 10, color: 'text-yellow-200' },
        ];

        const roles = [
            { id: 'top', name: '탑 (Top)' },
            { id: 'jungle', name: '정글 (Jungle)' },
            { id: 'mid', name: '미드 (Mid)' },
            { id: 'adc', name: '원딜 (ADC)' },
            { id: 'support', name: '서폿 (Support)' }
        ];

        // Initialize UI
        function initUI() {
            const container = document.getElementById('roles-container');
            let tierOptions = tiers.map(t => `<option value="${t.value}" class="bg-gray-800">${t.name} (${t.value}점)</option>`).join('');
            
            // Set default tiers (e.g., Gold as default)
            const defaultTierValue = 3; 

            roles.forEach(role => {
                const roleHTML = `
                    <div class="bg-gray-800/50 p-4 rounded-lg border border-gray-700/50 hover:border-wr-gold/50 transition-colors">
                        <div class="flex items-center mb-3">
                            <div class="w-2 h-6 bg-wr-gold mr-3"></div>
                            <h3 class="text-xl font-bold text-gray-100">${role.name}</h3>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <!-- Player 1 -->
                            <div class="flex gap-2">
                                <input type="text" id="${role.id}-p1-name" placeholder="플레이어 1 이름" class="w-1/2 bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-wr-gold transition-colors">
                                <select id="${role.id}-p1-tier" class="w-1/2 bg-gray-900 border border-gray-600 rounded px-2 py-2 text-white focus:outline-none focus:border-wr-gold transition-colors">
                                    ${tierOptions}
                                </select>
                            </div>
                            <!-- Player 2 -->
                            <div class="flex gap-2">
                                <input type="text" id="${role.id}-p2-name" placeholder="플레이어 2 이름" class="w-1/2 bg-gray-900 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-wr-gold transition-colors">
                                <select id="${role.id}-p2-tier" class="w-1/2 bg-gray-900 border border-gray-600 rounded px-2 py-2 text-white focus:outline-none focus:border-wr-gold transition-colors">
                                    ${tierOptions}
                                </select>
                            </div>
                        </div>
                    </div>
                `;
                container.innerHTML += roleHTML;
            });
            
            // Set defaults after injection
            roles.forEach(role => {
                document.getElementById(`${role.id}-p1-tier`).value = defaultTierValue;
                document.getElementById(`${role.id}-p2-tier`).value = defaultTierValue;
            });
        }

        // Get tier color class by value
        function getTierColor(value) {
            const tier = tiers.find(t => t.value === parseInt(value));
            return tier ? tier.color : 'text-white';
        }

        // Get tier name by value
        function getTierName(value) {
            const tier = tiers.find(t => t.value === parseInt(value));
            return tier ? tier.name.split(' ')[0] : 'Unknown';
        }

        // Balancing Logic
        function generateTeams() {
            const playersData = [];
            let isValid = true;

            // Collect Data
            roles.forEach(role => {
                const p1NameInput = document.getElementById(`${role.id}-p1-name`).value.trim();
                const p1Name = p1NameInput || `${role.name.split(' ')[0]} 1`;
                const p1Tier = parseInt(document.getElementById(`${role.id}-p1-tier`).value);

                const p2NameInput = document.getElementById(`${role.id}-p2-name`).value.trim();
                const p2Name = p2NameInput || `${role.name.split(' ')[0]} 2`;
                const p2Tier = parseInt(document.getElementById(`${role.id}-p2-tier`).value);

                playersData.push({
                    role: role.name,
                    p1: { name: p1Name, tierValue: p1Tier },
                    p2: { name: p2Name, tierValue: p2Tier }
                });
            });

            // 5 roles -> 2^5 = 32 combinations
            let bestDiff = Infinity;
            let bestCombinations = [];

            for (let i = 0; i < 32; i++) {
                let teamA = { score: 0, players: [] };
                let teamB = { score: 0, players: [] };

                for (let r = 0; r < 5; r++) {
                    // bit 0 means p1 to Team A, p2 to Team B
                    // bit 1 means p1 to Team B, p2 to Team A
                    const bit = (i >> r) & 1;
                    const roleData = playersData[r];

                    if (bit === 0) {
                        teamA.players.push({ ...roleData.p1, role: roleData.role });
                        teamA.score += roleData.p1.tierValue;
                        teamB.players.push({ ...roleData.p2, role: roleData.role });
                        teamB.score += roleData.p2.tierValue;
                    } else {
                        teamA.players.push({ ...roleData.p2, role: roleData.role });
                        teamA.score += roleData.p2.tierValue;
                        teamB.players.push({ ...roleData.p1, role: roleData.role });
                        teamB.score += roleData.p1.tierValue;
                    }
                }

                const diff = Math.abs(teamA.score - teamB.score);

                if (diff < bestDiff) {
                    bestDiff = diff;
                    bestCombinations = [{ teamA, teamB }];
                } else if (diff === bestDiff) {
                    bestCombinations.push({ teamA, teamB });
                }
            }

            // Pick a random combination among the best ones for variety
            const selectedCombination = bestCombinations[Math.floor(Math.random() * bestCombinations.length)];
            
            displayResults(selectedCombination.teamA, selectedCombination.teamB, bestDiff);
        }

        function displayResults(teamA, teamB, diff) {
            const resultsSection = document.getElementById('results-section');
            const teamACard = document.getElementById('team-a-card');
            const teamBCard = document.getElementById('team-b-card');
            
            // Reset animations
            resultsSection.classList.remove('hidden');
            teamACard.classList.remove('opacity-100', 'translate-y-0');
            teamBCard.classList.remove('opacity-100', 'translate-y-0');
            teamACard.classList.add('opacity-0', 'translate-y-4');
            teamBCard.classList.add('opacity-0', 'translate-y-4');

            // Force reflow
            void resultsSection.offsetWidth;

            // Update Difference
            const diffText = document.getElementById('score-difference');
            if (diff === 0) {
                diffText.innerHTML = `<span class="text-wr-blueLight">완벽한 밸런스!</span> (점수 차이: 0)`;
            } else {
                diffText.textContent = `양 팀 점수 차이: ${diff}점`;
            }

            // Render Team A
            document.getElementById('team-a-score').textContent = teamA.score;
            document.getElementById('team-a-list').innerHTML = teamA.players.map(p => `
                <li class="flex justify-between items-center bg-gray-900/60 p-3 rounded border border-gray-700 hover:border-blue-500/50 transition-colors">
                    <span class="text-gray-400 font-bold w-16">${p.role.split(' ')[0]}</span>
                    <span class="text-white font-medium flex-1 px-4 truncate text-center">${p.name}</span>
                    <span class="font-bold ${getTierColor(p.tierValue)} w-20 text-right">${getTierName(p.tierValue)}</span>
                </li>
            `).join('');

            // Render Team B
            document.getElementById('team-b-score').textContent = teamB.score;
            document.getElementById('team-b-list').innerHTML = teamB.players.map(p => `
                <li class="flex justify-between items-center bg-gray-900/60 p-3 rounded border border-gray-700 hover:border-red-500/50 transition-colors">
                    <span class="text-gray-400 font-bold w-16">${p.role.split(' ')[0]}</span>
                    <span class="text-white font-medium flex-1 px-4 truncate text-center">${p.name}</span>
                    <span class="font-bold ${getTierColor(p.tierValue)} w-20 text-right">${getTierName(p.tierValue)}</span>
                </li>
            `).join('');

            // Trigger animations
            setTimeout(() => {
                teamACard.classList.remove('opacity-0', 'translate-y-4');
                teamACard.classList.add('opacity-100', 'translate-y-0');
            }, 100);

            setTimeout(() => {
                teamBCard.classList.remove('opacity-0', 'translate-y-4');
                teamBCard.classList.add('opacity-100', 'translate-y-0');
                
                // Scroll to results smoothly
                resultsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }, 300);
        }

        // Initialize
        document.addEventListener('DOMContentLoaded', () => {
            initUI();
            document.getElementById('generate-btn').addEventListener('click', generateTeams);
        });

    </script>
</body>
</html>
